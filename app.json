{
  "expo": {
    "name": "Cthos",
    "slug": "cthos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cthos.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Cthos to perform speech recognition for conversational responses.",
        "NSMicrophoneUsageDescription": "Allow Cthos to use your microphone for voice commands."
      }
    },
    "android": {
      "package": "com.cthos.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Cthos to access your microphone for real-time voice conversations.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Cthos to use your microphone for voice commands.",
          "speechRecognitionPermission": "Allow Cthos to perform speech recognition for conversational responses.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1c206740-f601-487f-b82b-e8dba1fb2269"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_YOUR_EAS_PROJECT_ID"
    },
    "owner": "shimul702"
  }
}
